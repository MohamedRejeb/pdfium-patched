+// The decoded data of the content streams an edit touches, written back in
+// one go once every change has been made.
+class ContentStreamEdits {
+ public:
+  explicit ContentStreamEdits(CPDF_Page* page) : page_(page) {}
+
+  // Null when |stream_index| names no stream of the page.
+  DataVector<uint8_t>* DataOf(int32_t stream_index) {
+    auto it = data_.find(stream_index);
+    if (it != data_.end()) {
+      return &it->second;
+    }
+    RetainPtr<const CPDF_Stream> stream =
+        GetContentStreamAt(page_, stream_index);
+    if (!stream) {
+      return nullptr;
+    }
+    auto accessor = pdfium::MakeRetain<CPDF_StreamAcc>(std::move(stream));
+    accessor->LoadAllDataFiltered();
+    const pdfium::span<const uint8_t> decoded = accessor->GetSpan();
+    return &data_
+                .emplace(stream_index,
+                         DataVector<uint8_t>(decoded.begin(), decoded.end()))
+                .first->second;
+  }
+
+  // All or nothing: no stream is written unless every one of them can be.
+  bool Commit() {
+    for (const auto& [stream_index, data] : data_) {
+      if (!CanReplaceContentStreamData(page_, stream_index)) {
+        return false;
+      }
+    }
+    for (const auto& [stream_index, data] : data_) {
+      if (!ReplaceContentStreamData(page_, stream_index, data)) {
+        return false;
+      }
+    }
+    return true;
+  }
+
+ private:
+  UnownedPtr<CPDF_Page> const page_;
+  std::map<int32_t, DataVector<uint8_t>> data_;
+};
+
+struct ByteRange {
+  size_t begin = 0;
+  size_t end = 0;
+
+  bool empty() const { return end <= begin; }
+};
+
+bool IsTokenBreak(uint8_t ch) {
+  return PDFCharIsWhitespace(ch) || PDFCharIsDelimiter(ch);
 }
+
+// Finds the `/Name Do` operator that ends at |operator_end|, or returns an
+// empty range when the bytes there are anything else.
+ByteRange FindPaintOperator(pdfium::span<const uint8_t> data,
+                            size_t operator_end,
+                            const ByteString& resource_name) {
+  if (operator_end == 0 || operator_end > data.size() ||
+      resource_name.IsEmpty()) {
+    return {};
+  }
+  size_t end = operator_end;
+  while (end > 0 && PDFCharIsWhitespace(data[end - 1])) {
+    --end;
+  }
+  if (end < 2 || data[end - 2] != 'D' || data[end - 1] != 'o') {
+    return {};
+  }
+  size_t cursor = end - 2;
+  if (cursor == 0 || !PDFCharIsWhitespace(data[cursor - 1])) {
+    return {};
+  }
+  while (cursor > 0 && PDFCharIsWhitespace(data[cursor - 1])) {
+    --cursor;
+  }
+  const size_t name_end = cursor;
+  while (cursor > 0 && !IsTokenBreak(data[cursor - 1])) {
+    --cursor;
+  }
+  if (cursor == 0 || data[cursor - 1] != '/' || cursor == name_end) {
+    return {};
+  }
+  const ByteString written_name(
+      ByteStringView(data.subspan(cursor, name_end - cursor)));
+  if (PDF_NameDecode(written_name.AsStringView()) != resource_name) {
+    return {};
+  }
+  return {cursor - 1, end};
+}
+
+// The `q` ... `Q` pair recorded for |obj|, or an empty range when the bytes
+// there are anything else.
+ByteRange FindGroup(pdfium::span<const uint8_t> data,
+                    const CPDF_PageObject* obj) {
+  const CPDF_PageObject::SourceSpan& span = obj->source_span();
+  if (!span.has_group() || span.group_end > data.size()) {
+    return {};
+  }
+  const size_t begin = span.group_begin;
+  const size_t end = span.group_end;
+  const bool opens = data[begin] == 'q' &&
+                     (begin == 0 || IsTokenBreak(data[begin - 1])) &&
+                     IsTokenBreak(data[begin + 1]);
+  const bool closes = data[end - 1] == 'Q' && IsTokenBreak(data[end - 2]) &&
+                      (end == data.size() || IsTokenBreak(data[end]));
+  return opens && closes ? ByteRange{begin, end} : ByteRange{};
+}
+
+bool IsEditableInPlace(const CPDF_Page* page, const CPDF_PageObject* obj) {
+  return obj && obj->IsActive() && !obj->IsDirty() &&
+         obj->GetContentStream() >= 0 && PageOwnsObject(page, obj);
+}
