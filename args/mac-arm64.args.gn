# gn args for mac-arm64 build of patched PDFium.
# Mirror of bblanchon/pdfium-binaries' verified-working args for chromium/7811.

clang_use_chrome_plugins = false
is_component_build = false
is_debug = false
pdf_enable_v8 = false
pdf_enable_xfa = false
pdf_is_standalone = true
pdf_use_partition_alloc = false
target_cpu = "arm64"
target_os = "mac"
treat_warnings_as_errors = false
