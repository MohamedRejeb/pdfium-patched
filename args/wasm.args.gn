# gn args for wasm (Emscripten target — Web / WASI consumers).
# Aligned with bblanchon/pdfium-binaries' verified-working args for chromium/7811.
#
# Three notable differences from the native targets:
#   * pdf_is_complete_lib = true — produce a single libpdfium.a that
#     em++ then links into pdfium.{wasm,js,html}. The shared_library
#     conversion infra patch doesn't apply here (em++ owns the link).
#   * is_clang = false — the wasm toolchain (//build/toolchain/wasm)
#     runs em++ which is its own clang frontend; gn shouldn't try to
#     pick chromium's clang.
#   * use_custom_libcxx = false — emsdk ships its own libc++ with
#     custom entry points; we use that, not chromium's libc++.

is_component_build = false
is_clang = false
is_debug = false
pdf_enable_v8 = false
pdf_enable_xfa = false
pdf_is_complete_lib = true
pdf_is_standalone = true
pdf_use_partition_alloc = false
target_cpu = "wasm"
target_os = "emscripten"
treat_warnings_as_errors = false
use_custom_libcxx = false
