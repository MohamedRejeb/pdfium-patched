+// ============================================================================
+// Patch 0009 — pattern-fill rasterisation + Type 3 vector char enumeration.
+//
+// Two unrelated capabilities, but both unblock the same downstream renderer
+// fallback path (single-object rasterise to FPDF_BITMAP) when the vector
+// chain can't reproduce upstream's output. Bundled because the C++ surface
+// they pull in (pattern, Type 3 form objects, the render pipeline) is the
+// same — splitting would duplicate the include/header churn for marginal
+// benefit and the patches/ folder grows linearly with no clearer mapping.
+
+namespace {
+
+// Resolve an FPDF_PAGEOBJECT to a CPDF_PathObject*, returning nullptr if the
+// handle is not a path object. Mirrors AsTextObject above; used by the
+// FPDFRejeb_PathObj* exports so callers don't have to verify
+// FPDFPageObj_GetType() == FPDF_PAGEOBJ_PATH first.
+CPDF_PathObject* AsPathObject(FPDF_PAGEOBJECT page_object) {
+  if (!page_object) {
+    return nullptr;
+  }
+  CPDF_PageObject* obj = CPDFPageObjectFromFPDFPageObject(page_object);
+  if (!obj || !obj->IsPath()) {
+    return nullptr;
+  }
+  return obj->AsPath();
+}
+
+// Resolve (text_obj, char_index) to the CPDF_Form* backing that Type 3 char's
+// glyph procedure, or nullptr if any step fails (non-text obj, out-of-range
+// index, sentinel charcode, non-Type-3 font, no glyph for charcode). Shared
+// by the two Type-3 char-object accessors below so the (text -> font -> Type3
+// cast -> LoadChar -> form -> CPDF_Form downcast) chain only lives once.
+//
+// Safety of the static_cast: PDFium 7811's CPDF_Form is the *only* concrete
+// CPDF_Font::FormIface implementation AND is declared `final` (verified at
+// core/fpdfapi/page/cpdf_form.h:24 — `class CPDF_Form final :
+// public CPDF_PageObjectHolder, public CPDF_Font::FormIface`). If upstream
+// ever adds a second impl, this cast becomes UB and a runtime check needs
+// to replace it.
+const CPDF_Form* GetType3CharForm(CPDF_TextObject* text, int char_index) {
+  if (!text || char_index < 0 ||
+      static_cast<size_t>(char_index) >= text->CharCount()) {
+    return nullptr;
+  }
+  uint32_t charcode = text->GetCharCode(static_cast<size_t>(char_index));
+  if (charcode == 0xFFFFFFFFu) {
+    return nullptr;  // TJ-array number-adjustment slot, not a real glyph
+  }
+  RetainPtr<CPDF_Font> font = text->GetFont();
+  if (!font || !font->IsType3Font()) {
+    return nullptr;
+  }
+  CPDF_Type3Font* t3 = font->AsType3Font();
+  if (!t3) {
+    return nullptr;
+  }
+  CPDF_Type3Char* glyph = t3->LoadChar(charcode);
+  if (!glyph) {
+    return nullptr;
+  }
+  return static_cast<const CPDF_Form*>(glyph->form());
+}
+
+}  // namespace
+
+FPDF_EXPORT int FPDF_CALLCONV
+FPDFRejeb_PathObjGetFillPatternKind(FPDF_PAGEOBJECT path_obj) {
+  CPDF_PathObject* path = AsPathObject(path_obj);
+  if (!path) {
+    return -1;
+  }
+  const CPDF_Color* fill_color = path->color_state().GetFillColor();
+  if (!fill_color || !fill_color->IsPattern()) {
+    return 0;  // No pattern fill (solid color, default state, etc.)
+  }
+  RetainPtr<CPDF_Pattern> pattern = fill_color->GetPattern();
+  if (!pattern) {
+    return 0;  // IsPattern() lied (shouldn't happen, but fail soft)
+  }
+  // CPDF_Pattern doesn't expose a public GetType() — discriminate by which
+  // of the two virtual As<Kind>Pattern() accessors returns non-null. PDFium
+  // declares these in core/fpdfapi/page/cpdf_pattern.h with default
+  // nullptr returns; CPDF_TilingPattern / CPDF_ShadingPattern override.
+  if (pattern->AsTilingPattern()) {
+    return 1;  // Tiling
+  }
+  if (pattern->AsShadingPattern()) {
+    return 2;  // Shading
+  }
+  return 0;  // Unknown (future pattern subclass — should not happen at 7811)
+}
+
+FPDF_EXPORT FPDF_BITMAP FPDF_CALLCONV
+FPDFRejeb_PathObjGetRenderedBitmap(FPDF_DOCUMENT document,
+                                   FPDF_PAGE page,
+                                   FPDF_PAGEOBJECT path_obj,
+                                   float scale) {
+  // Mirrors FPDFTextObj_GetRenderedBitmap (fpdfsdk/fpdf_edittext.cpp:524)
+  // step-for-step, with a CPDF_PathObject* in place of CPDF_TextObject*.
+  // CPDF_RenderStatus::RenderSingleObject takes any CPDF_PageObject*, so
+  // the only thing that varies is the bbox source (path->GetRect() vs
+  // text->GetRect()) and the AsPathObject downcast.
+  CPDF_Document* doc = CPDFDocumentFromFPDFDocument(document);
+  if (!doc) {
+    return nullptr;
+  }
+  CPDF_Page* optional_page = CPDFPageFromFPDFPage(page);
+  if (optional_page && optional_page->GetDocument() != doc) {
+    return nullptr;
+  }
+  CPDF_PathObject* path = AsPathObject(path_obj);
+  if (!path) {
+    return nullptr;
+  }
+  if (scale <= 0) {
+    return nullptr;
+  }
+
+  const CFX_Matrix scale_matrix(scale, 0, 0, scale, 0, 0);
+  const CFX_FloatRect& path_rect = path->GetRect();
+  const CFX_FloatRect scaled_rect = scale_matrix.TransformRect(path_rect);
+
+  // `rect` has to use integer values. Round up as needed.
+  const FX_RECT rect = scaled_rect.GetOuterRect();
+  if (rect.IsEmpty()) {
+    return nullptr;
+  }
+
+  auto result_bitmap = pdfium::MakeRetain<CFX_DIBitmap>();
+  if (!result_bitmap->Create(rect.Width(), rect.Height(),
+                             FXDIB_Format::kBgra)) {
+    return nullptr;
+  }
+
+  // The render-context plumbing below is the same dance upstream uses:
+  // a fresh CPDF_PageRenderContext owned by the page (so resource lookups
+  // for patterns, shadings, fonts route through page resources), with a
+  // CFX_DefaultRenderDevice attached to our throwaway bitmap. The
+  // RenderContextClearer RAII guard restores the page's prior state
+  // even if we early-return.
+  auto render_context = std::make_unique<CPDF_PageRenderContext>();
+  CPDF_PageRenderContext* render_context_ptr = render_context.get();
+  CPDF_Page::RenderContextClearer clearer(optional_page);
+  if (optional_page) {
+    optional_page->SetRenderContext(std::move(render_context));
+  }
+
+  RetainPtr<CPDF_Dictionary> page_resources =
+      optional_page ? optional_page->GetMutablePageResources() : nullptr;
+
+  auto device = std::make_unique<CFX_DefaultRenderDevice>();
+  CFX_DefaultRenderDevice* device_ptr = device.get();
+  render_context_ptr->device_ = std::move(device);
+  render_context_ptr->context_ = std::make_unique<CPDF_RenderContext>(
+      doc, std::move(page_resources), /*pPageCache=*/nullptr);
+
+  device_ptr->Attach(result_bitmap);
+
+  CFX_Matrix device_matrix(rect.Width(), 0, 0, rect.Height(), 0, 0);
+  CPDF_RenderStatus status(render_context_ptr->context_.get(), device_ptr);
+  status.SetDeviceMatrix(device_matrix);
+  status.Initialize(nullptr, nullptr);
+
+  // Need to flip the rendering and also move it to fit within `result_bitmap`.
+  CFX_Matrix render_matrix(1, 0, 0, -1, -path_rect.left, path_rect.top);
+  render_matrix *= scale_matrix;
+  status.RenderSingleObject(path, render_matrix);
+
+  ValidateBitmapPremultiplyState(result_bitmap);
+
+  // Caller takes ownership.
+  return FPDFBitmapFromCFXDIBitmap(result_bitmap.Leak());
+}
+
+FPDF_EXPORT int FPDF_CALLCONV
+FPDFRejeb_TextObjGetType3CharObjectCount(FPDF_PAGEOBJECT text_obj,
+                                         int char_index) {
+  const CPDF_Form* form = GetType3CharForm(AsTextObject(text_obj), char_index);
+  if (!form) {
+    return -1;
+  }
+  return static_cast<int>(form->GetPageObjectCount());
+}
+
+FPDF_EXPORT FPDF_PAGEOBJECT FPDF_CALLCONV
+FPDFRejeb_TextObjGetType3CharObjectAt(FPDF_PAGEOBJECT text_obj,
+                                      int char_index,
+                                      int obj_index) {
+  const CPDF_Form* form = GetType3CharForm(AsTextObject(text_obj), char_index);
+  if (!form || obj_index < 0 ||
+      static_cast<size_t>(obj_index) >= form->GetPageObjectCount()) {
+    return nullptr;
+  }
+  // Returned page object is owned by the Type 3 char's form (which is owned
+  // by the font, which is owned by the document). Lifetime tied to document.
+  return FPDFPageObjectFromCPDFPageObject(
+      form->GetPageObjectByIndex(static_cast<size_t>(obj_index)));
+}
+
+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFRejeb_TextObjGetType3FontMatrix(FPDF_PAGEOBJECT text_obj,
+                                    float* out_a,
+                                    float* out_b,
+                                    float* out_c,
+                                    float* out_d,
+                                    float* out_e,
+                                    float* out_f) {
+  if (!out_a || !out_b || !out_c || !out_d || !out_e || !out_f) {
+    return false;
+  }
+  CPDF_TextObject* text = AsTextObject(text_obj);
+  if (!text) {
+    return false;
+  }
+  RetainPtr<CPDF_Font> font = text->GetFont();
+  if (!font || !font->IsType3Font()) {
+    return false;
+  }
+  CPDF_Type3Font* t3 = font->AsType3Font();
+  if (!t3) {
+    return false;
+  }
+  // CFX_Matrix uses lowercase a..f public fields directly (no getters);
+  // see core/fxcrt/fx_coordinates.h:490+. Type 3 font matrix maps per-glyph
+  // unit space (typically /FontBBox normalised to 1/1000 units) into the
+  // font's text space — every non-text rendering of a Type 3 glyph needs
+  // it composed with the text-object matrix to land in page space.
+  const CFX_Matrix& m = t3->GetFontMatrix();
+  *out_a = m.a;
+  *out_b = m.b;
+  *out_c = m.c;
+  *out_d = m.d;
+  *out_e = m.e;
+  *out_f = m.f;
+  return true;
+}
