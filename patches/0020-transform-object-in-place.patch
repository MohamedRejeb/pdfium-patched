 bool IsEditableInPlace(const CPDF_Page* page, const CPDF_PageObject* obj) {
   return obj && obj->IsActive() && !obj->IsDirty() &&
          obj->GetContentStream() >= 0 && PageOwnsObject(page, obj);
+}
+
+// Moves every recorded position of |stream_index| at or past |position| by
+// |delta| bytes, after an edit changed the stream's length there.
+void ShiftSourceSpans(CPDF_Page* page,
+                      int32_t stream_index,
+                      size_t position,
+                      int64_t delta) {
+  const auto shift = [position, delta](uint32_t& value) {
+    if (value != 0 && value >= position) {
+      value = static_cast<uint32_t>(static_cast<int64_t>(value) + delta);
+    }
+  };
+  for (const auto& candidate : *page) {
+    if (candidate->GetContentStream() != stream_index) {
+      continue;
+    }
+    CPDF_PageObject::SourceSpan& span = candidate->mutable_source_span();
+    const bool has_group = span.has_group();
+    shift(span.operator_end);
+    shift(span.group_end);
+    if (has_group && span.group_begin >= position) {
+      span.group_begin =
+          static_cast<uint32_t>(static_cast<int64_t>(span.group_begin) + delta);
+    }
+  }
 }
 
