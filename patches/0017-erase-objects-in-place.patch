+  span.clipped = true;
+  span.clip_is_rectangles = clip.GetTextCount() == 0;
+  for (size_t i = 0; i < clip.GetPathCount(); ++i) {
+    span.clip_is_rectangles = span.clip_is_rectangles && clip.GetPath(i).IsRect();
