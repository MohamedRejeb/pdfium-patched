# gn args for ios-simulator-x64 (Xcode simulator on Intel Mac hosts).
# Aligned with bblanchon/pdfium-binaries' verified-working args for chromium/7811.

clang_use_chrome_plugins = false
ios_enable_code_signing = false
is_component_build = false
is_debug = false
pdf_enable_v8 = false
pdf_enable_xfa = false
pdf_is_standalone = true
pdf_use_partition_alloc = false
target_cpu = "x64"
target_environment = "simulator"
target_os = "ios"
treat_warnings_as_errors = false
use_blink = true
