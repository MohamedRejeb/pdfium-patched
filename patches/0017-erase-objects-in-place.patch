+FPDF_EXPORT FPDF_BOOL FPDF_CALLCONV
+FPDFRejeb_PageEraseObjects(FPDF_PAGE page,
+                           const FPDF_PAGEOBJECT* page_objects,
+                           int count) {
+  CPDF_Page* cpage = CPDFPageFromFPDFPage(page);
+  if (!cpage || !page_objects || count <= 0) {
+    return false;
+  }
+
+  struct Erasure {
+    CPDF_PageObject* obj;
+    DataVector<uint8_t>* data;
+    ByteRange range;
+  };
+  ContentStreamEdits edits(cpage);
+  std::vector<Erasure> erasures;
+  // SAFETY: the caller passes |count| handles.
+  auto handles = UNSAFE_BUFFERS(
+      pdfium::span<const FPDF_PAGEOBJECT>(page_objects,
+                                          static_cast<size_t>(count)));
+  for (FPDF_PAGEOBJECT handle : handles) {
+    CPDF_PageObject* obj = CPDFPageObjectFromFPDFPageObject(handle);
+    if (!IsEditableInPlace(cpage, obj)) {
+      return false;
+    }
+    DataVector<uint8_t>* data = edits.DataOf(obj->GetContentStream());
+    if (!data) {
+      return false;
+    }
+    ByteRange range;
+    if (obj->AsImage()) {
+      range = FindPaintOperator(*data, obj->source_span().operator_end,
+                                obj->GetResourceName());
+    }
+    if (range.empty()) {
+      range = FindGroup(*data, obj);
+    }
+    if (range.empty()) {
+      return false;
+    }
+    erasures.push_back({obj, data, range});
+  }
+
+  // Nothing has changed up to here. Blanking keeps every length, so the
+  // positions recorded for the other objects stay valid.
+  for (const Erasure& erasure : erasures) {
+    for (size_t i = erasure.range.begin; i < erasure.range.end; ++i) {
+      (*erasure.data)[i] = ' ';
+    }
+  }
+  if (!edits.Commit()) {
+    return false;
+  }
+  for (const Erasure& erasure : erasures) {
+    // SetIsActive() flags the object dirty, which would send its stream
+    // through the generator after all.
+    erasure.obj->SetIsActive(false);
+    erasure.obj->SetDirty(false);
+  }
+
+  CPDF_PageContentGenerator generator(cpage);
+  generator.UpdateResourcesDict();
+  return true;
+}
