+bool PageOwnsObject(const CPDF_Page* page, const CPDF_PageObject* obj) {
+  for (const auto& candidate : *page) {
+    if (candidate.get() == obj) {
+      return true;
+    }
+  }
+  return false;
+}
+
+// Mirrors how CPDF_ContentParser numbers a page's content streams: the
+// position in the /Contents array, or 0 for a single stream.
+RetainPtr<const CPDF_Stream> GetContentStreamAt(const CPDF_Page* page,
+                                                int32_t index) {
+  RetainPtr<const CPDF_Dictionary> dict = page->GetDict();
+  if (!dict || index < 0) {
+    return nullptr;
+  }
+  RetainPtr<const CPDF_Object> contents = dict->GetDirectObjectFor("Contents");
+  if (!contents) {
+    return nullptr;
+  }
+  if (const CPDF_Stream* stream = contents->AsStream()) {
+    return index == 0 ? pdfium::WrapRetain(stream) : nullptr;
+  }
+  const CPDF_Array* array = contents->AsArray();
+  if (!array || static_cast<size_t>(index) >= array->size()) {
+    return nullptr;
+  }
+  return ToStream(array->GetDirectObjectAt(index));
+}
+
+// Whether ReplaceContentStreamData() can do its job for stream |index|.
+bool CanReplaceContentStreamData(CPDF_Page* page, int32_t index) {
+  RetainPtr<CPDF_Dictionary> page_dict = page->GetMutableDict();
+  if (!page->GetDocument() || !page_dict || index < 0) {
+    return false;
+  }
+  RetainPtr<CPDF_Object> contents =
+      page_dict->GetMutableDirectObjectFor("Contents");
+  if (!contents) {
+    return false;
+  }
+  if (contents->IsStream()) {
+    return index == 0;
+  }
+  CPDF_Array* array = contents->AsMutableArray();
+  if (!array || static_cast<size_t>(index) >= array->size()) {
+    return false;
+  }
+  RetainPtr<CPDF_Reference> reference =
+      ToReference(array->GetMutableObjectAt(static_cast<size_t>(index)));
+  return reference && ToStream(reference->GetMutableDirect());
+}
+
+// Gives content stream |index| of |page| new data. A stream or /Contents
+// array other pages reference too is left alone: the page gets its own
+// copy. CPDF_PageContentManager does the same but must not be used while
+// the page has streams waiting to be regenerated.
+bool ReplaceContentStreamData(CPDF_Page* page,
+                              int32_t index,
+                              pdfium::span<const uint8_t> data) {
+  CPDF_Document* doc = page->GetDocument();
+  RetainPtr<CPDF_Dictionary> page_dict = page->GetMutableDict();
+  if (!doc || !page_dict || index < 0) {
+    return false;
+  }
+  const std::set<uint32_t> shared = GetObjectsWithMultipleReferences(doc);
+  const auto is_shared = [&shared](const CPDF_Object* object) {
+    return object->GetObjNum() != 0 &&
+           shared.find(object->GetObjNum()) != shared.end();
+  };
+  const auto new_stream_number = [doc, data]() {
+    return doc
+        ->NewIndirect<CPDF_Stream>(DataVector<uint8_t>(data.begin(), data.end()),
+                                   doc->New<CPDF_Dictionary>())
+        ->GetObjNum();
+  };
+
+  RetainPtr<CPDF_Object> contents =
+      page_dict->GetMutableDirectObjectFor("Contents");
+  if (!contents) {
+    return false;
+  }
+  if (CPDF_Stream* stream = contents->AsMutableStream()) {
+    if (index != 0) {
+      return false;
+    }
+    if (is_shared(stream)) {
+      page_dict->SetNewFor<CPDF_Reference>("Contents", doc,
+                                           new_stream_number());
+    } else {
+      stream->SetDataAndRemoveFilter(data);
+    }
+    return true;
+  }
+
+  RetainPtr<CPDF_Array> array = pdfium::WrapRetain(contents->AsMutableArray());
+  if (!array || static_cast<size_t>(index) >= array->size()) {
+    return false;
+  }
+  if (is_shared(array.Get())) {
+    array = pdfium::WrapRetain(array->Clone()->AsMutableArray());
+    page_dict->SetFor("Contents", array);
+  }
+  RetainPtr<CPDF_Reference> reference =
+      ToReference(array->GetMutableObjectAt(static_cast<size_t>(index)));
+  RetainPtr<CPDF_Stream> stream =
+      reference ? ToStream(reference->GetMutableDirect()) : nullptr;
+  if (!stream) {
+    return false;
+  }
+  if (is_shared(stream.Get())) {
+    reference->SetRef(doc, new_stream_number());
+  } else {
+    stream->SetDataAndRemoveFilter(data);
+  }
+  return true;
+}
