# Build infrastructure patch (always applied; not counted in PATCHES_VERSION).
#
# Convert PDFium's `pdfium` target from `component()` (which becomes
# static_library when is_component_build = false) into an explicit
# `shared_library`, so that ninja produces libpdfium.{dylib|so|dll}
# rather than a static archive.
#
# Source: bblanchon/pdfium-binaries patches/shared_library.patch (BSD-3-Clause).
#         The Windows resources.rc lines from upstream are intentionally
#         omitted — we don't ship Windows DLL metadata.
diff --git a/BUILD.gn b/BUILD.gn
index 62210c2f6..053fbff6d 100644
--- a/BUILD.gn
+++ b/BUILD.gn
@@ -341,7 +341,7 @@ group("pdfium_public_headers") {
   ]
 }

-component("pdfium") {
+shared_library("pdfium") {
   output_name = "pdfium"
   libs = []
   configs += [ ":pdfium_strict_config" ]
